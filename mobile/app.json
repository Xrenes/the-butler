{
  "expo": {
    "name": "The Butler",
    "slug": "the-butler",
    "scheme": "butler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.thebutler.mobile",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "The Butler rings a real alarm when a task starts or ends, so you never miss it."
      }
    },
    "android": {
      "package": "app.thebutler.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#101727",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "The Butler uses Face ID to confirm it's you before resetting your finance PIN."
        }
      ],
      "expo-font",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.1"
          }
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#111111"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
