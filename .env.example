# Copy this file to .env.local and fill it in. .env.local is git-ignored; never commit it.
# These values are read by the server only. Never prefix them with NEXT_PUBLIC_,
# because that would ship them to the browser.

# Bot token from @BotFather. Used by the server to send reminders; the app never asks for it in the UI.
TELEGRAM_BOT_TOKEN=
